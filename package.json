{
	"name": "omk-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "npm@11.14.1",
	"workspaces": [
		"packages/*",
		"packages/coding-agent/examples/extensions/with-deps",
		"packages/coding-agent/examples/extensions/custom-provider-anthropic",
		"packages/coding-agent/examples/extensions/custom-provider-gitlab-duo",
		"packages/coding-agent/examples/extensions/sandbox",
		"packages/coding-agent/examples/extensions/gondolin"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "cd packages/tui && npm run build && cd ../ai && npm run build && cd ../agent && npm run build && cd ../adaptorch-wpl && npm run build && cd ../coding-agent && npm run build",
		"check": "biome check --write --error-on-warnings . && npm run check:pinned-deps && npm run check:vendored-skills && npm run check:ts-imports && npm run check:release-consistency && npm run check:readme-releases && npm run check:doc-links && npm run check:release-surface && npm run check:shrinkwrap && tsgo --noEmit && npm run check:browser-smoke",
		"check:browser-smoke": "node scripts/check-browser-smoke.mjs",
		"check:doc-links": "node scripts/check-doc-links.mjs",
		"check:pinned-deps": "node scripts/check-pinned-deps.mjs",
		"check:release-consistency": "node scripts/check-release-consistency.mjs",
		"check:release-surface": "node scripts/check-release-surface.mjs",
		"check:readme-releases": "node scripts/sync-readme-releases.mjs --check",
		"sync:readme-releases": "node scripts/sync-readme-releases.mjs",
		"check:shrinkwrap": "node scripts/generate-coding-agent-shrinkwrap.mjs --check",
		"check:ts-imports": "node scripts/check-ts-relative-imports.mjs",
		"check:vendored-skills": "node scripts/check-vendored-skills.mjs",
		"profile:tui": "node scripts/profile-coding-agent-node.mjs --mode tui",
		"profile:rpc": "node scripts/profile-coding-agent-node.mjs --mode rpc",
		"test": "npm run test --workspaces --if-present",
		"version:patch": "npm version patch --workspaces --include-workspace-root --no-git-tag-version && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts",
		"version:minor": "npm version minor --workspaces --include-workspace-root --no-git-tag-version && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts",
		"version:major": "npm version major --workspaces --include-workspace-root --no-git-tag-version && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts",
		"version:set": "npm version --workspaces --include-workspace-root",
		"prepublishOnly": "npm run clean && npm run build && npm run check",
		"publish": "npm run prepublishOnly && node scripts/publish.mjs",
		"publish:dry": "npm run prepublishOnly && node scripts/publish.mjs --dry-run",
		"release:local": "node scripts/local-release.mjs",
		"shrinkwrap:coding-agent": "node scripts/generate-coding-agent-shrinkwrap.mjs",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"harness-graph": "bash .omk/harness-graph/run.sh",
		"harness-graph:compact-index": "node .omk/harness-graph/compact-skills-index.mjs",
		"prepare": "husky"
	},
	"knip": {
		"ignore": [
			".omk/harness-graph/**",
			"vendor/**"
		]
	},
	"devDependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.26",
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"esbuild": "0.28.1",
		"husky": "9.1.7",
		"jiti": "2.7.0",
		"shx": "0.4.0",
		"tsx": "4.22.1",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.95.0",
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		},
		"ws": "8.21.0",
		"minimatch": "10.2.6",
		"brace-expansion": "5.0.8",
		"postcss": "8.5.24",
		"protobufjs": "7.6.5",
		"shell-quote": "1.10.0",
		"vite": {
			".": "7.3.5",
			"esbuild": "0.28.1"
		},
		"@earendil-works/gondolin": {
			"undici": "6.27.0"
		}
	}
}
